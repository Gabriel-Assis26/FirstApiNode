    {
      "name": "04 - POST Cadastrar novo produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Produto criado deve possuir os atributos esperados\", function () {\r",
              "    const produto = pm.response.json();\r",
              "    pm.expect(produto).to.have.property(\"id\");\r",
              "    pm.expect(produto.descricao).to.eql(\"Teclado Mecanico RGB\");\r",
              "});\r",
              "\r",
              "pm.test(\"Salvar o id do produto criado\", function () {\r",
              "    const produto = pm.response.json();\r",
              "    pm.collectionVariables.set(\"novoProdutoId\", produto.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"descricao\": \"Teclado Mecanico RGB\",\r\n  \"preco\": 350.90,\r\n  \"categoria\": \"Perifericos\",\r\n  \"estoque\": 25\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
