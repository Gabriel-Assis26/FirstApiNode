          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Resposta deve ser um array\", function () {\r",
              "    const dados = pm.response.json();\r",
              "    pm.expect(dados).to.be.an(\"array\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
